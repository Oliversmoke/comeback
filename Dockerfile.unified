# Single-container image: Next.js pages + the ENTIRE backend (bundled into one
# file: server/dist/backend.bundle.mjs) + Socket.IO, all in one process.
#
# NOTE: the repo's root .dockerignore currently excludes `server/` and `client/`,
# which would prevent COPY below from working. For a clean single-container build
# either run docker from a context that includes them, or adjust .dockerignore to
# allow `server/dist` and `client`.
FROM node:20-alpine AS deps
WORKDIR /app

COPY server/package.json server/package-lock.json ./server/
RUN npm install --prefix server
COPY client/package.json client/package-lock.json ./client/
RUN npm install --prefix client

FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/server/node_modules ./server/node_modules
COPY --from=deps /app/client/node_modules ./client/node_modules
COPY server/ ./server/
COPY client/ ./client/
# Build the client with same-origin API/socket URLs (one port, one link).
ENV NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_SOCKET_URL=""
RUN npm run build --prefix client
# Collapse the whole backend into one file.
RUN npm run build:backend --prefix server

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV UNIFIED_SERVER=true
ENV NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_SOCKET_URL=""
ENV PORT=3000

# Only the single backend file + the built client are needed at runtime.
COPY --from=builder /app/server/dist/backend.bundle.mjs ./server/dist/backend.bundle.mjs
COPY --from=builder /app/client/.next ./client/.next
COPY --from=builder /app/client/public ./client/public
COPY --from=builder /app/client/package.json ./client/package.json
COPY --from=builder /app/client/next.config.ts ./client/next.config.ts
COPY --from=builder /app/client/node_modules ./client/node_modules

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1
CMD ["node", "client/unified-server.mjs"]
