# Supabase Postgres — Prisma (pooler). Replace [YOUR-PASSWORD] with the
# project's database password. Percent-encode special characters.
# Transaction-mode pooler (app queries, IPv4)
DATABASE_URL="postgresql://postgres.cvkkelnfttrpiqqzhhfq:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (migrations)
DIRECT_URL="postgresql://postgres.cvkkelnfttrpiqqzhhfq:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Passport Google OAuth
