# StakeMind - environment configuration
# Copy to .env and fill in real values. The API server has its own
# authoritative reference in server/.env.example; the indexer requires
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (fail-fast if missing).

# API server (server/)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stakemind

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Passport Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stellar SEP-10 wallet auth (Freighter)
STELLAR_AUTH_SECRET=your-stellar-server-signing-secret-key
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_AUTH_DOMAIN=localhost:5000

# AI Provider (openai, anthropic, gemini, or fallback)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email / Backup System
OWNER_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="StakeMind <noreply@stakemind.ai>"

# Indexer (indexer/)
SUPABASE_URL=your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web client (client/) - prefix with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STAKING_TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2UGCQMYP
NEXT_PUBLIC_GOAL_STAKING_CONTRACT_ID=CD4IITXUDTML3VGTGK5UBMA4JHYILBDHOVMIDQGH6HUU4FCJRZ6TA2F7
NEXT_PUBLIC_GROUP_ESCROW_CONTRACT_ID=CCX736W2FX4ETKPBKKXEANQO4KP43FVMKTLFVN3JWDCTIIHDIYCS25PI
